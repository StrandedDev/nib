<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX v3 source for the nib MSI, in the layout `cargo wix init` produces.
  Built by `cargo wix` in .github/workflows/release.yml; cargo-wix defines
  $(var.Version) and $(var.CargoTargetBinDir) for the chosen target.

  Per-machine install into Program Files\nib\bin, appended to the system
  PATH, upgraded in place by MajorUpgrade, listed in Add or remove programs.

  UpgradeCode and the Path component GUID must never change: they are how
  Windows recognises a newer nib MSI as an upgrade of an older one.
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='nib'
        UpgradeCode='E85554BD-1245-4705-ACD1-84A98142CD27'
        Manufacturer='StrandedDev'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='A small, fast, distraction-free terminal text editor'
            Manufacturer='StrandedDev'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='nib Installation'/>

        <Property Id='ARPHELPLINK' Value='https://github.com/StrandedDev/nib'/>
        <Property Id='ARPURLINFOABOUT' Value='https://github.com/StrandedDev/nib'/>
        <Property Id='ARPNOMODIFY' Value='1'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='nib'>

                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            Name='LICENSE.txt'
                            DiskId='1'
                            Source='LICENSE'
                            KeyPath='yes'/>
                    </Component>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='C13B74EF-C915-4B9D-9E5A-3E0EE457AB52' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>

                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='nib.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\nib.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='nib'
            Description='Installs nib.exe and adds it to the system PATH.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='License'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='Path'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

    </Product>

</Wix>
